# TiTiler for “Visualize on map” COG tiles (default: https://titiler.xyz). Set to 0 to disable.
NEXT_PUBLIC_TITILER_URL=https://titiler.xyz
# Optional: override tile path if your TiTiler uses another template (must include {z}/{x}/{y})
# NEXT_PUBLIC_TITILER_COG_TILES_PATH=/cog/tiles/WebMercatorQuad/{z}/{x}/{y}

NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=your-static-token
DIRECTUS_SECRET=must-match-directus-jwt-secret
PROVIDER_API_KEY=your-highres-provider-key
HIGHRES_PROVIDER_BASE_URL=https://your-provider.example.com/api
